# systemd unit for the AllergyLens live data server on the GX10.
# Install with tools/server/install.sh (it fills in the user and repo path).
[Unit]
Description=AllergyLens data server (menus.json / products.json for the Lens)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
# API key for the model path lives here (root-only, never in git): ANTHROPIC_API_KEY=… or OPENAI_API_KEY=…
EnvironmentFile=-/etc/allergylens.env
# Build the joined data WITH the scraper's lake (data-lake -> ~/AllergyLens/data-lake), then put the
# compiled snapshot back so the serve clone stays clean for `git pull`. The server reads data/menus.lens.json.
ExecStartPre=/bin/bash -c 'node tools/build-data.js --with-lake && git checkout -q -- Assets/Data/AllergyData.ts'
ExecStart=__REPO__/.venv/bin/python -u tools/serve_data.py --host 0.0.0.0 --port 8787 --llm --lake /home/__USER__/AllergyLens/data-lake
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
