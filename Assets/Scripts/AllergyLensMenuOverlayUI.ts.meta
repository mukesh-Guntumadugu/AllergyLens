  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">AllergyLensMenuOverlayUI – highlights + badge on a tracked real menu</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string restaurantId = "star-of-india" {"hint":"Restaurant id from the data (must have a menuImage). The marker on this object is that page."}'
    - "// @input float barPaddingCm = 0.2 {\"hint\":\"Padding (cm) added around each printed line's OCR box; bars are otherwise exactly the line's width and height.\", \"widget\":\"slider\", \"min\":0, \"max\":0.5, \"step\":0.05}"
    - '// @input float barAlpha = 0.6 {"hint":"Opacity of the highlight bars over the paper.", "widget":"slider", "min":0.1, "max":1, "step":0.05}'
    - '// @input vec3 safeColor = "{0.55, 0.95, 0.6}" {"hint":"Bar tint for safe dishes.", "widget":"color"}'
    - '// @input vec3 flagColor = "{0.98, 0.45, 0.45}" {"hint":"Bar tint for dishes that contain something from the profile.", "widget":"color"}'
    - '// @input vec3 unverifiedColor = "{1.0, 0.8, 0.3}" {"hint":"Bar tint for dishes whose ingredients are not published.", "widget":"color"}'
    - '// @input float lostHideDelaySec = 1 {"hint":"Seconds to keep the overlay after the marker is lost before hiding it.", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - "// @input float badgeEdgeOffsetCm = -0.9 {\"hint\":\"Badge chip centre relative to the page's top edge, in cm: negative = inside the page's top margin (default), positive = floating above the edge.\", \"widget\":\"slider\", \"min\":-4, \"max\":4, \"step\":0.1}"
    - "// @input float badgeWidthCm = 15 {\"hint\":\"Badge chip width in cm. Keep it inside the glasses' display band (~55% of the page width).\", \"widget\":\"slider\", \"min\":8, \"max\":30, \"step\":0.5}"
    - '// @ui {"widget":"group_end"}'
